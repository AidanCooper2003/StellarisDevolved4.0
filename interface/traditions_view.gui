	################################################################
	# TRADITION VIEW
	################################################################
	@tradition_w = 1560
	containerWindowType = {
		name = "traditions_view"
		size = { width = @tradition_w height = 900 }
		show_position = { x = 35 y = 50 }
		hide_position = { x = -100% y = 50 }
		animation_time = 200
		animation_type = decelerated
		if_scaled_resolution = {
			min_height = 1200
			size = { width = @tradition_w height = 1020 }
		}
		if_scaled_resolution = {
			min_height = 1440
			size = { width = @tradition_w height = 1185 }
		}
		if_scaled_resolution = {
			min_width = 2560
